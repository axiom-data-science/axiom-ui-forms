{
  "id": "pam-site-form",
  "label": "PAM Site",
  "pages": [
    {
      "id": "pam_site",
      "label": "Site",
      "description": "Fixed monitoring location",
      "fields": [
        {
              "prop": "site_code"
        },
        {
          "id": "location",
          "type": "objectWrapper",
          "skip_path": true,
          "label": "Location",
          "settings":{
            "boldLabel": true
          },
          "layout": "grid3",
          "fields": [
            {
              "prop": "latitude",
              "settings": {

              }
            },
            {
              "prop": "longitude",
              "settings": {

              }
            },
            {
              "prop": "water_depth_m"
            },
            {
              "prop": "time_zone"
            }
          ]
        }
      ]
    },
    {
      "id": "pam_deployment",
      "label": "Deployment",
      "description": "Deployment event details",
      "fields":  [
        {
          "prop": "deployment_code"
        },
        {
          "id": "deployment_time_range",
          "type": "objectWrapper",
          "layout": "grid2",
          "label": "Time range",
          "settings":{
            "boldLabel": true
          },
          "fields": [
            {"prop": "deployments[].monitoring_start_datetime"},
            {"prop": "deployments[].monitoring_end_datetime"}
          ]
        },
        {
          "id": "deployment_platform_description",
          "type": "objectWrapper",
          "layout": "grid2",
          "label": "Platform",
          "settings":{
            "boldLabel": true
          },
          "fields": [
            {"prop": "deployments[].deployment_platform_type_code"},
            {
              "prop": "deployments[].deployment_platform_id",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            }
          ]
        },
        {
          "id": "misc_deployment_info",
          "type": "objectWrapper",
          "label": "Misc",
          "settings":{
            "boldLabel": true
          },
          "fields": [
            {
                  "prop": "deployments[].deployment_depth_m"
            },
            {
              "prop": "deployments[].deployment_url",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
          },
            {"prop": "deployments[].dynamic_management_platform"}

          ]
        },
        {
          "prop": "deployments[].gps_data_uri", "type": "file_upload",
          "description": "Upload a GPS file if deployment is a trajectory",
          "settings": {
            "boldLabel": true
          }
        }
      ]
    },
    {
      "id": "pam_recordings",
      "label": "Recordings",
      "description": "Recording devices and analysis runs for this deployment",
      "fields": [
        {
          "prop": "deployments[].recordings",
          "type": "object",
          "multiple": true,
          "tabs": [
            {
              "id": "recording_info",
              "label": "Device & Config",
              "fields": [
                {
                  "id": "device_id_wrap",
                  "type": "objectWrapper",
                  "layout": "grid2",
                  "label": "Device identifiers",
                  "settings":{
                    "boldLabel": true
                  },
                  "fields": [
                    {
                      "prop": "deployments[].recordings[].recording_device_code"
                    },
                    {
                      "prop": "deployments[].recordings[].recording_device_type_code"
                    }
                  ]
                },
                {
                  "id": "device_config_wrap",
                  "type": "objectWrapper",
                  "layout": "grid3",
                  "label": "Configurations",
                  "settings":{
                    "boldLabel": true
                  },
                  "fields": [
                    {
                      "prop": "deployments[].recordings[].recording_bit_depth"
                    },
                    {
                      "prop": "deployments[].recordings[].recording_n_channels"
                    },
                    {
                      "prop": "deployments[].recordings[].recording_sample_rate_khz"
                    }

                  ]
                },
                {
                  "id": "device_duration_wrap",
                  "type": "objectWrapper",
                  "label": "Duration & Interval",
                  "settings":{
                    "boldLabel": true
                  },
                  "fields": [
                    {
                      "prop": "deployments[].recordings[].recording_duration_secs"
                    },
                    {
                      "prop": "deployments[].recordings[].recording_interval_secs"
                    }

                  ]
                }
              ]
            },
            {
              "id": "analyses_tab",
              "label": "Analyses",
              "fields": [
                {
                  "prop": "deployments[].recordings[].analyses",
                  "label": "",
                  "fields": [
                    {
                      "prop": "analysis_organization_code"
                    },
                    {
                      "id": "analyses_time_wrap",
                      "type": "objectWrapper",
                      "layout": "grid2",
                      "label": "Time range",
                      "settings":{
                        "boldLabel": true,
                         "className": "bg-slate-100 px-0"
                      },
                      "fields": [
                        {
                          "prop": "analysis_start_datetime",
                          "type": "datetime"
                        },
                        {
                          "prop": "analysis_end_datetime",
                          "type": "datetime"
                        }
                      ]
                    },
                    {
                      "id": "analyses_configuration_wrap",
                      "label": "Analysis Configuration",
                      "type": "objectWrapper",
                      "settings":{
                        "boldLabel": true,
                         "className": "bg-slate-100 px-0"
                      },
                      "fields":[
                        {
                          "id": "analyses_configuration_wrap2",
                          "type": "objectWrapper",
                          "layout": "grid3",
                          "label": "",
                          "settings":{
                            "className": "px-0 pb-0"
                          },
                          "fields": [
                            {
                              "prop": "analysis_sample_rate_khz",
                              "settings": {
                                "descriptionPresentation": "tooltip"
                              }
                            },
                            {
                              "prop": "analysis_min_frequency_khz",
                              "settings": {
                                "descriptionPresentation": "tooltip"
                              }
                            },
                            {
                              "prop": "analysis_max_frequency_khz",
                              "settings": {
                                "descriptionPresentation": "tooltip"
                              }
                            }

                          ]
                        },

                        {
                          "prop": "analysis_sound_source_codes",
                          "settings": {
                            "className": "p-4 bg-slate-200"
                          }
                        }
                      ]
                    },
                    {
                      "id": "analyses_detector_wrap",
                      "type": "objectWrapper",
                      "layout": "grid2",
                      "label": "Detector",
                      "settings":{
                        "boldLabel": true,
                         "className": "bg-slate-100 px-0"
                      },
                      "fields": [
                       {
                          "prop": "analysis_detector_code",
                          "settings": {
                            "descriptionPresentation": "tooltip"
                          }
                        },
                        {
                          "prop": "analysis_detector_version",
                          "settings": {
                            "descriptionPresentation": "tooltip"
                          }
                        }
                      ]
                    },

                    {
                      "prop": "analysis_processing_code"
                    },
                    {
                      "prop": "analysis_protocol_reference"
                    },
                    {
                      "prop": "analysis_citations",
                      "type": "long_text"
                    },
                    {
                      "prop": "detections_data_uri",
                      "type": "file_upload"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}