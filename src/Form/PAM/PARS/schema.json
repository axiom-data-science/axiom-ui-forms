{
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PAM Deployment",
      "description": "One deployment event including recordings and analyses",
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "title": "Project",
          "properties": {
            "project": { "type": "string", "title": "Project", "description": "Project name", "minLength": 1 },
            "dataSubmitter": { "type": "string", "title": "Data Submitter", "description": "Person responsible for submitting the data" },
            "sources": { "type": "array", "title": "Sources", "description": "Organizations responsible for data collection", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
            "funders": { "type": "array", "title": "Funders", "description": "Organizations that funded the data collection", "items": { "type": "string" } },
            "scientists": { "type": "array", "title": "Scientists", "description": "People involved in collecting or processing the data", "items": { "type": "string" } },
            "relatedProjects": { "type": "array", "title": "Related Projects", "description": "Overarching projects for which the data were collected", "items": { "type": "string", "minLength": 1 } }
          },
          "required": ["project", "dataSubmitter", "sources"]
        },
        "site": {
          "type": "object",
          "title": "Site",
          "properties": {
            "siteOrCruiseName": { "type": "string", "title": "Site or Cruise Name", "description": "Location name, cruise ID, or site" },
            "alternateSiteName": { "type": "string", "title": "Alternate Site Name", "description": "Alternate site label" },
            "platform": { "type": "string", "title": "Platform", "description": "Platform on which the acoustic recorders were deployed", "minLength": 1 },
            "locationDetail": {
              "type": "object",
              "title": "Location Detail",
              "oneOf": [
                {
                  "title": "Mobile Marine Location",
                  "type": "object",
                  "properties": {
                    "seaArea": { "type": "string", "title": "Sea Area" },
                    "locationDerivationDescription": { "type": "string", "title": "Location Derivation Description", "minLength": 1 },
                    "navigationFileURIList": { "type": "array", "title": "Navigation Files", "items": { "type": "string", "format": "uri" }, "minItems": 1 }
                  },
                  "required": ["locationDerivationDescription", "navigationFileURIList"]
                },
                {
                  "title": "Multipoint Stationary Marine Location",
                  "type": "object",
                  "properties": {
                    "seaArea": { "type": "string", "title": "Sea Area" },
                    "locations": { "type": "array", "title": "Locations", "items": { "$ref": "#/definitions/marineInstrumentLocation" }, "minItems": 1 }
                  },
                  "required": ["locations"]
                },
                {
                  "title": "Stationary Marine Location",
                  "type": "object",
                  "properties": {
                    "seaArea": { "type": "string", "title": "Sea Area" },
                    "deploymentLocation": { "$ref": "#/definitions/marineInstrumentLocation" },
                    "recoveryLocation": { "$ref": "#/definitions/marineInstrumentLocation" }
                  },
                  "required": ["deploymentLocation", "recoveryLocation"]
                },
                {
                  "title": "Stationary Terrestrial Location",
                  "type": "object",
                  "properties": {
                    "latitude": { "type": "number", "title": "Latitude", "minimum": -90, "maximum": 90 },
                    "longitude": { "type": "number", "title": "Longitude", "minimum": -180, "maximum": 180 },
                    "surfaceElevation": { "type": "number", "title": "Surface Elevation" },
                    "instrumentElevation": { "type": "number", "title": "Instrument Elevation" }
                  },
                  "required": ["latitude", "longitude", "surfaceElevation", "instrumentElevation"]
                }
              ]
            }
          },
          "required": ["platform", "locationDetail"]
        },
        "deployment_code": { "type": "string", "title": "Deployment Code", "description": "Unique deployment identifier (links all PARS CSVs)" },
        "monitoring_start_datetime": { "type": "string", "format": "date-time", "title": "Monitoring Start" },
        "monitoring_end_datetime": { "type": "string", "format": "date-time", "title": "Monitoring End" },
        "deployment_platform_type_code": { "type": "string", "title": "Platform Type", "enum": ["BOTTOM_MOUNTED_MOORING", "DRIFTING_BUOY", "ELECTRIC_GLIDER", "MOORED_SURFACE_BUOY", "TOWED_ARRAY", "WAVE_GLIDER"] },
        "deployment_platform_id": { "type": "string", "title": "Platform ID" },
        "deployment_url": { "type": "string", "format": "uri", "title": "Deployment URL" },
        "dynamic_management_platform": { "type": "boolean", "title": "Dynamic Management Platform" },
        "deployment_water_depth_m": { "type": "number", "title": "Water Depth (m)", "minimum": 0 },
        "points_of_contact": {
          "type": "array",
          "title": "Points of Contact",
          "items": {
            "type": "object",
            "properties": {
              "contact_name": { "type": "string", "title": "Full Name" },
              "contact_email": { "type": "string", "format": "email", "title": "Email" }
            },
            "required": ["contact_name", "contact_email"]
          }
        },
        "gps_data_uri": { "type": "string", "format": "uri", "title": "GPS Track File", "description": "URI to gpsdata.csv for mobile deployments" },
        "recordings": {
          "type": "array",
          "title": "Recordings",
          "items": {
            "type": "object",
            "properties": {
              "recording_device_code": { "type": "string", "title": "Device Code", "description": "e.g. SOUNDTRAP-6078" },
              "recording_device_type_code": { "type": "string", "title": "Device Type Code", "description": "e.g. SOUNDTRAP, DMON" },
              "recording_device_depth_m": { "type": "number", "title": "Hydrophone Depth (m)", "minimum": 0 },
              "recording_sample_rate_khz": { "type": "number", "title": "Sample Rate (kHz)", "minimum": 0 },
              "recording_duration_secs": { "type": "number", "title": "Recording Duration (s)", "minimum": 0 },
              "recording_interval_secs": { "type": "number", "title": "Recording Interval (s)", "minimum": 0 },
              "recording_bit_depth": { "type": "integer", "title": "Bit Depth", "minimum": 0 },
              "recording_n_channels": { "type": "integer", "title": "Number of Channels", "minimum": 0, "default": 1 },
              "recording_timezone": { "type": "string", "title": "Recording Timezone" },
              "analyses": {
                "type": "array",
                "title": "Analyses",
                "items": {
                  "type": "object",
                  "properties": {
                    "analysis_organization_code": { "type": "string", "title": "Analysis Organization Code" },
                    "analysis_sound_source_codes": { "type": "array", "title": "Sound Source Codes", "items": { "type": "string" } },
                    "analysis_start_datetime": { "type": "string", "format": "date-time", "title": "Analysis Start" },
                    "analysis_end_datetime": { "type": "string", "format": "date-time", "title": "Analysis End" },
                    "analysis_sample_rate_khz": { "type": "number", "title": "Analysis Sample Rate (kHz)", "minimum": 0 },
                    "analysis_min_frequency_khz": { "type": "number", "title": "Min Frequency (kHz)", "minimum": 0, "default": 0 },
                    "analysis_max_frequency_khz": { "type": "number", "title": "Max Frequency (kHz)", "minimum": 0 },
                    "analysis_processing_code": { "type": "string", "title": "Processing Code", "enum": ["POST_PROCESSED", "REAL_TIME"] },
                    "analysis_protocol_reference": { "type": "string", "title": "Protocol Reference" },
                    "analysis_citations": { "type": "string", "title": "Citations" },
                    "analysis_detector_code": { "type": "string", "title": "Detector Code" },
                    "analysis_detector_version": { "type": "string", "title": "Detector Version" },
                    "detections_data_uri": { "type": "string", "format": "uri", "title": "Detections File" }
                  },
                  "required": ["analysis_organization_code", "analysis_sound_source_codes", "analysis_start_datetime", "analysis_end_datetime", "analysis_sample_rate_khz", "analysis_min_frequency_khz", "analysis_max_frequency_khz", "analysis_processing_code", "analysis_protocol_reference", "analysis_detector_code", "analysis_detector_version"]
                }
              }
            },
            "required": ["recording_device_code", "recording_device_type_code", "recording_device_depth_m", "recording_sample_rate_khz", "recording_duration_secs", "recording_interval_secs", "recording_bit_depth", "recording_n_channels", "recording_timezone"]
          }
        }
      },
      "definitions": {
        "marineInstrumentLocation": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number", "title": "Latitude", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "title": "Longitude", "minimum": -180, "maximum": 180 },
            "seaFloorDepth": { "type": "number", "title": "Seafloor Depth", "exclusiveMaximum": 0 },
            "instrumentDepth": { "type": "number", "title": "Instrument Depth", "exclusiveMaximum": 0 }
          },
          "required": ["latitude", "longitude", "instrumentDepth"]
        }
      },
      "required": ["project", "site", "deployment_code", "monitoring_start_datetime", "monitoring_end_datetime", "deployment_platform_type_code", "deployment_water_depth_m", "points_of_contact", "recordings"]
    }