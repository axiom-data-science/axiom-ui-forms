{
      "id": "pam-deployment-form",
      "label": "PAM Deployment",
      "pages": [
        {
          "id": "project",
          "label": "Project",
          "description": "Project ownership and submission details",
          "fields": [
            { "prop": "_project", "type": "object", "skip_path": true, "label": "", "fields": [
              { "prop": "project.project" },
              { "prop": "project.dataSubmitter" },
              { "prop": "project.sources" },
              { "prop": "project.funders" },
              { "prop": "project.scientists" },
              { "prop": "project.relatedProjects" }
            ]}
          ]
        },
        {
          "id": "site",
          "label": "Site",
          "description": "Site identity, platform, and location details",
          "fields": [
            { "prop": "site", "type": "object", "label": "", "fields": [
              { "prop": "site.siteOrCruiseName" },
              { "prop": "site.alternateSiteName" },
              { "prop": "site.platform" },
              { "prop": "site.locationDetail" }
            ]}
          ]
        },
        {
          "id": "deployment-info",
          "label": "Deployment",
          "description": "Dataset, instrument, files, and deployment timing",
          "fields": [
            {
              "prop": "deployment",
              "type": "object",
              "label": "",
              "fields": [
                { "prop": "deployment.dataCollectionName" },
                { "prop": "deployment.averageFileLengthMinutes" },
                { "prop": "deployment.deploymentTitle" },
                { "prop": "deployment.deploymentDescription", "type": "long_text" },
                { "prop": "deployment.deploymentId" },
                { "prop": "deployment.alternateDeploymentName" },
                { "prop": "deployment.instrument" },
                { "prop": "deployment.instrumentId" },
                { "prop": "deployment.sensitivityFlatValue" },
                { "prop": "deployment.preDeploymentCalibrationDate" },
                { "prop": "deployment.postDeploymentCalibrationDate" },
                { "prop": "deployment.calibrationState" },
                { "prop": "deployment.calibrationDescription", "type": "long_text" },
                { "prop": "deployment.sourceURI" },
                { "prop": "deployment.calibrationDocumentsURI" },
                { "prop": "deployment.documentsURI" },
                { "prop": "deployment.temperatureURI" },
                { "prop": "deployment.otherURI" },
                { "prop": "deployment.deploymentTime" },
                { "prop": "deployment.recoveryTime" },
                { "prop": "deployment.audioStartTime" },
                { "prop": "deployment.audioEndTime" },
                { "prop": "deployment.comments", "type": "long_text" }
              ]
            }
          ]
        },
        {
          "id": "pam_recordings",
          "label": "Recordings",
          "description": "Recording devices and analysis runs for this deployment",
          "fields": [
            {
              "prop": "recordings",
              "type": "object",
              "multiple": true,
              "tabs": [
                {
                  "id": "recording_info",
                  "label": "Device & Config",
                  "fields": [
                    { "prop": "recordings[].recording_device_code" },
                    { "prop": "recordings[].recording_device_type_code" },
                    { "prop": "recordings[].recording_device_depth_m" },
                    { "prop": "recordings[].recording_sample_rate_khz" },
                    { "prop": "recordings[].recording_duration_secs" },
                    { "prop": "recordings[].recording_interval_secs" },
                    { "prop": "recordings[].recording_bit_depth" },
                    { "prop": "recordings[].recording_n_channels" },
                    { "prop": "recordings[].recording_timezone" }
                  ]
                },
                {
                  "id": "analyses",
                  "label": "Analyses",
                  "fields": [
                    {
                      "prop": "recordings[].analyses",
                      "type": "object",
                      "multiple": true,
                      "tabs": [
                        {
                          "id": "analysis_info",
                          "label": "Analysis",
                          "fields": [
                            { "prop": "recordings[].analyses[].analysis_organization_code" },
                            { "prop": "recordings[].analyses[].analysis_sound_source_codes" },
                            { "prop": "recordings[].analyses[].analysis_start_datetime" },
                            { "prop": "recordings[].analyses[].analysis_end_datetime" },
                            { "prop": "recordings[].analyses[].analysis_processing_code" },
                            { "prop": "recordings[].analyses[].analysis_detector_code" },
                            { "prop": "recordings[].analyses[].analysis_detector_version" },
                            { "prop": "recordings[].analyses[].analysis_sample_rate_khz" },
                            { "prop": "recordings[].analyses[].analysis_min_frequency_khz" },
                            { "prop": "recordings[].analyses[].analysis_max_frequency_khz" },
                            { "prop": "recordings[].analyses[].analysis_protocol_reference" },
                            { "prop": "recordings[].analyses[].analysis_citations" },
                            { "prop": "recordings[].analyses[].detections_data_uri" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  