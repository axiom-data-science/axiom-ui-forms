{
      "id": "pam-deployment-form",
      "label": "PAM Deployment",
      "pages": [
        {
          "id": "project",
          "label": "Project",
          "description": "Project ownership and submission details",
          "fields": [
            { "prop": "_project", "type": "object", "skip_path": true, "label": "", "fields": [
              { "prop": "project.project" },
              { "prop": "project.dataSubmitter" },
              { "prop": "project.sources" },
              { "prop": "project.funders" },
              { "prop": "project.scientists" },
              { "prop": "project.relatedProjects" }
            ]}
          ]
        },
        {
          "id": "site",
          "label": "Site",
          "description": "Site identity, platform, and location details",
          "fields": [
            { "prop": "site", "type": "object", "label": "", "fields": [
              { "prop": "site.siteOrCruiseName" },
              { "prop": "site.alternateSiteName" },
              { "prop": "site.platform" },
              { "prop": "site.locationDetail" }
            ]}
          ]
        },
        {
          "id": "deployment-info",
          "label": "Deployment",
          "description": "Dataset, instrument, files, and deployment timing",
          "fields": [
            {
              "prop": "deployment",
              "type": "object",
              "label": "",
              "fields": [
                { "prop": "deployment.dataCollectionName" },
                { "prop": "deployment.averageFileLengthMinutes" },
                { "prop": "deployment.deploymentTitle" },
                { "prop": "deployment.deploymentDescription", "type": "long_text" },
                { "prop": "deployment.deploymentId" },
                { "prop": "deployment.alternateDeploymentName" },
                { "prop": "deployment.instrument" },
                { "prop": "deployment.instrumentId" },
                { "prop": "deployment.sensitivityFlatValue" },
                { "prop": "deployment.preDeploymentCalibrationDate" },
                { "prop": "deployment.postDeploymentCalibrationDate" },
                { "prop": "deployment.calibrationState" },
                { "prop": "deployment.calibrationDescription", "type": "long_text" },
                { "prop": "deployment.sourceURI" },
                { "prop": "deployment.calibrationDocumentsURI" },
                { "prop": "deployment.documentsURI" },
                { "prop": "deployment.temperatureURI" },
                { "prop": "deployment.otherURI" },
                { "prop": "deployment.deploymentTime" },
                { "prop": "deployment.recoveryTime" },
                { "prop": "deployment.audioStartTime" },
                { "prop": "deployment.audioEndTime" },
                { "prop": "deployment.comments", "type": "long_text" }
              ]
            }
          ]
        },
        {
          "id": "pam_recordings",
          "label": "Recordings",
          "description": "Audio channels, sample rates, and duty cycles for this deployment",
          "fields": [
            {
              "prop": "deployment.recordings",
              "type": "object",
              "multiple": true,
              "fields": [
                {
                  "prop": "deployment.recordings[].channels",
                  "type": "object",
                  "multiple": true,
                  "fields": [
                    { "prop": "deployment.recordings[].channels[].startTime" },
                    { "prop": "deployment.recordings[].channels[].endTime" },
                    {
                      "prop": "deployment.recordings[].channels[].sampleRates",
                      "type": "object",
                      "multiple": true,
                      "fields": [
                        { "prop": "deployment.recordings[].channels[].sampleRates[].startTime" },
                        { "prop": "deployment.recordings[].channels[].sampleRates[].endTime" },
                        { "prop": "deployment.recordings[].channels[].sampleRates[].sampleRate" },
                        { "prop": "deployment.recordings[].channels[].sampleRates[].sampleBits" }
                      ]
                    },
                    {
                      "prop": "deployment.recordings[].channels[].dutyCycles",
                      "type": "object",
                      "multiple": true,
                      "fields": [
                        { "prop": "deployment.recordings[].channels[].dutyCycles[].startTime" },
                        { "prop": "deployment.recordings[].channels[].dutyCycles[].endTime" },
                        { "prop": "deployment.recordings[].channels[].dutyCycles[].duration" },
                        { "prop": "deployment.recordings[].channels[].dutyCycles[].interval" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "pam_analyses",
          "label": "Analyses",
          "description": "Quality assessments for this deployment",
          "fields": [
            {
              "prop": "deployment.analyses",
              "type": "object",
              "multiple": true,
              "fields": [
                { "prop": "deployment.analyses[].qualityAnalyst" },
                { "prop": "deployment.analyses[].qualityAssessmentDescription", "type": "long_text" },
                {
                  "prop": "deployment.analyses[].qualityEntries",
                  "type": "object",
                  "multiple": true,
                  "fields": [
                    { "prop": "deployment.analyses[].qualityEntries[].startTime" },
                    { "prop": "deployment.analyses[].qualityEntries[].endTime" },
                    { "prop": "deployment.analyses[].qualityEntries[].minFrequency" },
                    { "prop": "deployment.analyses[].qualityEntries[].maxFrequency" },
                    { "prop": "deployment.analyses[].qualityEntries[].qualityLevel" },
                    { "prop": "deployment.analyses[].qualityEntries[].comments", "type": "long_text" },
                    { "prop": "deployment.analyses[].qualityEntries[].channelNumbers" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  