import { type IValueType, type IFormField } from ***REMOVED***@/Form/FormCreatorTypes***REMOVED***
import FieldLabel from ***REMOVED***@/Form/Manager/Field/FieldLabel***REMOVED***
import formValuesAtom from ***REMOVED***@/state/formValuesAtom***REMOVED***
import { type ITextInputProps } from ***REMOVED***@axdspub/axiom-ui-utilities***REMOVED***
import { useAtom } from ***REMOVED***jotai***REMOVED***
import React, { useEffect, useState, type ReactElement } from ***REMOVED***react***REMOVED***

export type IInputProps<T extends IValueType> = Omit<ITextInputProps, ***REMOVED***value***REMOVED*** | ***REMOVED***onChange***REMOVED***> & {
  value: T
  onChange: (e: T) => void
}

export interface IInputComponentProps<T extends IValueType> {
  updateValue: (value: IValueType) => T
  Component: React.FC<IInputProps<T>>
}

export interface IRootProps<T extends IValueType> {
  field: IFormField
  onChange: () => void
  Input: IInputComponentProps<T>
}

function Root<T> ({
  field,
  onChange,
  Input
}: IRootProps<T>): ReactElement {
  const [formValues, setFormValues] = useAtom(formValuesAtom)
  const [value, setValue] = useState<T>(Input.updateValue(formValues[field.id]))

  return (
    <Input.Component
      label={<FieldLabel {...field} />}
      id={field.id}
      testId={field.id}
      value={field.value}
      onChange={(e) => {
        field.value = e
        onChange()
      }} />
  )
}
  )
}

function Text <T> ({
  field,
  onChange,
  updateValue,
  InputComponent
}: {
  field: IFormField
  onChange: () => void
  updateValue: (value: IValueType) => T
  InputComponent: React.FC<IInputProps>
}): ReactElement {
  const [formValues, setFormValues] = useAtom(formValuesAtom)
  const [value, setValue] = useState<T>(updateValue(formValues[field.id]))

  useEffect(() => {
    formValues[field.id] = value
    setFormValues({ ...formValues })
  }, [value])
  useEffect(() => {
    setValue(formValues[field.id] !== undefined ? String(formValues[field.id]) : ***REMOVED******REMOVED***)
  }, [formValues[field.id]])

  return (
      <InputComponent
            label={<FieldLabel {...field} />}
            id={field.id}
            testId={field.id}
            value={value}
            onChange={(e) => {
              field.value = e
              setValue(e !== undefined ? String(e) : ***REMOVED******REMOVED***)
              onChange()
            }} />
  )
}

export default Text
