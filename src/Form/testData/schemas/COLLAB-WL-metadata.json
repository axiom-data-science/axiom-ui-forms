{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Station Metadata",
    "type": "object",
    "properties": {
        "Prepared by": { "type": "string" },
        "Date prepared": { "type": "string", "format": "date" },
        "Update or new station?": { "type": "string", "enum": ["Update", "New"] },
        "Previous site log": { "type": "string" },
        "Modified/added section": { "type": "string" },
        "Reason for update": { "type": "string" },
        "Funding source": { "type": "string" },
        "Funding grant": { "type": "string" },
        "Deployment year of proposal": { "type": "string" },
        "Operator POC": { "type": "string" },
        "Telephone (primary)": { "type": "string" },
        "Email": { "type": "string", "format": "email" },
        "Affiliation": { "type": "string" },
        "Community POC": { "type": "string" },
        "Community POC name": { "type": "string" },
        "Community POC telephone": { "type": "string" },
        "Community POC email": { "type": "string", "format": "email" },
        "Community POC Affiliation": { "type": "string" },
        "Entity": { "type": "string" },
        "POC": { "type": "string" },
        "ERDDAP link": { "type": "string", "format": "uri" },
        "Portal link": { "type": "string", "format": "uri" },
        "Data provider": { "type": "string" },
        "Data provider - additional": { "type": "string" },
        "API link": { "type": "string", "format": "uri" },
        "Additional information": { "type": "string" },
        "State": { "type": "string" },
        "Station Name": { "type": "string" },
        "Station ID": { "type": "string" },
        "NWS Location Identifier": { "type": "string" },
        "Is this a CO-OPS Station? (yes/no)": { "type": "string", "enum": ["Yes", "No"] },
        "CO-OPS ID": { "type": "string" },
        "Other ID": { "type": "string" },
        "Water body setting": { "type": "string", "enum": ["Inlet", "River", "Ocean coastline", "Lake", "Other"] },
        "Approximate position": { "type": "string" },
        "Latitude (DD, N is +)": { "type": "number" },
        "Longitude (DD, E is +)": { "type": "number" },
        "Datum projection": { "type": "string" },
        "If CO-OPS, was there a prior location for this CO-OPs station?": { "type": "string", "enum": ["Yes", "No"] },
        "Type of CO-OPS approved station": { "type": "string" },
        "Instrument brand": { "type": "string", "enum": ["Hohonu", "Greenstream", "Hobo", "Divirod", "Community Sensor"] },
        "Sensor - type": { "type": "string", "enum": ["Radar", "Pressure (vented or non-vented)", "Acoustic", "GNSS-R", "GNSS Buoy", "Ultrasonic"] },
        "Sensor - brand/manufacturer": { "type": "string", "enum": ["Senix"] },
        "Sensor - Model": { "type": "string" },
        "Sensor - Serial number": { "type": "string" },
        "Real time?": { "type": "string", "enum": ["Yes"] },
        "Sample interval (min)": { "type": "string", "enum": ["1 min", "6 min", "15 min", "60 min", "Other"] },
        "Sample average window (sec)": { "type": "string", "enum": ["0 sec", "60 sec", "181 sec", "Other"] },
        "Mounting structure": { "type": "string", "enum": ["Bridge", "Seawall", "Dock", "Bedrock", "Anchor", "Other"] },
        "Sensor accuracy": { "type": "string" },
        "Date installed": { "type": "string", "format": "date" },
        "Date removed, if applicable": { "type": "string", "format": "date" },
        "Telemetry method": { "type": "string", "enum": ["Cellular", "Satellite", "Iridium", "GOES", "Wifi"] },
        "Modem/communication - Manufacturer & model": { "type": "string" },
        "Serial number": { "type": "string" },
        "Sensor vertical control": { "type": "string" },
        "Sensor survey information / Bench mark info": { "type": "string" },
        "Is the station surveyed?": { "type": "string", "enum": ["Yes", "No"] },
        "Marker information and stamping": { "type": "string" },
        "Marker stamping": { "type": "string" },
        "Marker NGS PID": { "type": "string" },
        "Marker CO-OPS VM#": { "type": "string" },
        "Marker other identifier": { "type": "string" },
        "Survey method": { "type": "string", "enum": ["Static GNSS", "RTK", "Optical Level", "Digital Level"] },
        "Date (of most recent survey)": { "type": "string", "format": "date" },
        "Measurement by (at most recent survey)": { "type": "string" },
        "Ortho height (NAVD88 m)": { "type": "number" },
        "Station datum height (m)": { "type": "number" },
        "Ellipsoidal height (m)": { "type": "number" },
        "Sensor offset (m)": { "type": "number" },
        "GNSS/RTK Unit": { "type": "string" },
        "Processing software": { "type": "string" },
        "Has there been movement since last survey?": { "type": "string", "enum": ["Yes", "No"] },
        "If so, what is the difference?": { "type": "number" },
        "Is the difference within 5 cm?": { "type": "string", "enum": ["Yes", "No"] },
        "Total Water level Error (cm)": { "type": "number" },
        "Sensor Error (cm)": { "type": "number" },
        "Survey Error (cm)": { "type": "number" },
        "Data Processing Error (cm)": { "type": "number" },
        "Datum Error (cm)": { "type": "number" },
        "Record Start Date": { "type": "string", "format": "date" },
        "Record End Date": { "type": "string", "format": "date" },
        "Computational Tool": { "type": "string", "enum": ["WALI", "CO-OPS Tidal Datum Analysis Calculator", "Tidelab", "Manual", "Other"] },
        "Computation method": { "type": "string", "enum": ["TBYT", "MMSC", "FRED"] },
        "NWLON Control Station": { "type": "string" },
        "Control Station Epoch": { "type": "string" },
        "Datum Type": { "type": "string", "enum": ["Standard NTDE", "Modified Procedure", "Direct"] },
        "Computation Date": { "type": "string", "format": "date" },
        "Computed by": { "type": "string" },
        "MHHW (m)": { "type": "number" },
        "MHW (m)": { "type": "number" },
        "DTL (m)": { "type": "number" },
        "MTL (m)": { "type": "number" },
        "MSL (m)": { "type": "number" },
        "MLW (m)": { "type": "number" },
        "MLLW (m)": { "type": "number" },
        "GT (m)": { "type": "number" },
        "MN (m)": { "type": "number" },
        "DHQ (m)": { "type": "number" },
        "DLQ (m)": { "type": "number" },
        "HWI (hr)": { "type": "number" },
        "LWI (hr)": { "type": "number" },
        "Is this a collocation? (yes/no)": { "type": "string", "enum": ["Yes", "No"] },
        "Instrument type": { "type": "string", "enum": ["Met package", "Web camera", "Secondary WL"] },
        "Manufacturer & model": { "type": "string" },
        "ECC": { "type": "string" },
        "ECC URL": { "type": "string", "format": "uri" },
        "Was Nepa Completed": { "type": "string" },
        "Notes": { "type": "string" },
        "Photos": { "type": "string" },
        "Station": { "type": "string" },
        "Sensor": { "type": "string" },
        "Sensor management": { "type": "string" },
        "Sensor survey reference point": { "type": "string" },
        "Photo of the two surveyed benchmark***REMOVED***s face stamping": { "type": "string" },
        "DCP": { "type": "string" },
        "Underwater components": { "type": "string" },
        "Vicinity": { "type": "string" },
        "Other / Attachments": { "type": "string" },
        "Bench mark diagram": { "type": "string" },
        "Sensor test worksheet": { "type": "string" },
        "Sensor elevation drawing": { "type": "string" },
        "Bench mark descriptions": { "type": "string" },
        "Station ***REMOVED***to-reach***REMOVED*** statement": { "type": "string" },
        "Disclaimer": { "type": "string" },
        "Dissemination flag": { "type": "string" }
    }
}
