    "properties": {
      "pt_model_type": {
        "anyOf": [
          {
            "$ref": "#/$defs/ParticleTrajectoryModel"
          },
          {
            "type": "null"
          }
        ],
        "default": "OpenDrift",
        "description": "Lagrangian model software to use for simulation."
      },
      "ocean_model": {
        "anyOf": [
          {
            "$ref": "#/$defs/OceanModel"
          },
          {
            "type": "null"
          }
        ],
        "default": "CIOFS",
        "description": "Name of ocean model to use for driving drifter simulation."
      },
      "geojson": {
        "anyOf": [
          {
            "$ref": "#/$defs/Point"
          },
          {
            "$ref": "#/$defs/LineString"
          },
          {
            "$ref": "#/$defs/Polygon"
          }
        ],
        "description": "GeoJSON describing a point, line, or polygon for seeding drifters.",
        "title": "Geojson"
      },
      "simulate_3d": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ],
        "default": false,
        "description": "Set to True to run drifters in 3D. If set to True, vertical advection and mixing are enabled.",
        "title": "Simulate 3D"
      },
      "z": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": 0.0,
        "description": "Depth below sea level where elements are released, ignored if seafloor seeding is selected.",
        "title": "Z"
      },
      "number": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": 100,
        "description": "The number of elements for the simulation.",
        "title": "Number"
      },
      "start_time": {
        "description": "Start time for drifter simulation.",
        "format": "date-time",
        "title": "Start Time",
        "type": "string"
      },
      "duration": {
        "description": "The length of the simulation in ISO 8601 format. steps, end_time, or duration must be input by user.",
        "title": "Duration",
        "type": "string"
      },
      "pt_model_specific_config": {
        "anyOf": [
          {
            "$ref": "#/$defs/OpenDriftConfig"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Model-specific configuration options. Depends on model_type."
      }
    },
    "required": [
      "geojson",
      "start_time",
      "duration"
    ],
    "title": "SimulationConfig",
    "type": "object"
