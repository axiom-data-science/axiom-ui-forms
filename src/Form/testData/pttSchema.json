        "ocean_model": "CIOFS",
        "pt_model_specific_config": {
          "scenario": "Oil",
          "scenario_config": {
            "oil_type": "GENERIC MEDIUM CRUDE"
          }
        },
        "pt_model_type": "OpenDrift",
        "simulate_3d": true,
        "start_time": "2023-08-01T00:00:00Z",
