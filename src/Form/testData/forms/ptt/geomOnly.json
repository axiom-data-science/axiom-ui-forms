{
  "id": "geom-tester",
  "label": "Geom tester",
  "fields": [
    {
      "id": "shape_type",
      "type": "select",
      "label": "Shape",
      "defaultValue": "point",
      "options": [
        { "value": "point", "label": "Point" },
        { "value": "linestring", "label": "Line" },
        { "value": "polygon", "label": "Polygon" }
      ]
    },
    {
      "id": "check",
      "type": "boolean",
      "label": "Check the checkbox"
    },
    {
      "id": "point",
      "destPath": "geojson",
      "type": "geometry",
      "label": null,
      "description": "Select a point on the map.",
      "settings": {
        "drawPointEnabled": true,
        "showCoordinateInput": false
      },
      "conditions": {
        "dependsOn": "shape_type",
        "value": "point"
      }
    },
    {
      "id": "polygon",
      "destPath": "geojson",
      "type": "geometry",
      "label": null,
      "description": "Draw a polygon on the map.",
      "settings": {
        "drawPolygonEnabled": true,
        "showCoordinateInput": false
      },
      "conditions": {
        "dependsOn": "shape_type",
        "value": "polygon"
      }
    },
    {
      "id": "linestring",
      "destPath": "geojson",
      "type": "geometry",
      "label": null,
      "description": "Draw a line on the map.",
      "settings": {
        "drawPathEnabled": true,
        "showCoordinateInput": false,
        "maxLineStringPoints": 2
      },
      "conditions": {
        "dependsOn": "shape_type",
        "value": "linestring"
      }
    }
  ]
}
