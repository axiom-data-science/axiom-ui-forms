{
  "label": "Form with object",
  "description": "Field 'value' is conditionally set to be disabled and have a value of 0 when 'checkboxField' is 'false'.",
  "id": "objectForm",
  "fields": [
    {
      "id": "checkboxField",
      "label": "Is it true?",
      "type": "boolean",
      "defaultValue": true
    },
    {
        "id": "value",
        "label": "Value - enable",
        "type": "number",
        "defaultValue": 5.4,
        "constraints": {
          "min": 0,
          "max": 10,
          "step": 0.1
        },
        "conditions": {
          "field": "checkboxField",
          "value": false,
          "result": "disable",
          "newDefaultValue": 0
        }
    }
    ]
}