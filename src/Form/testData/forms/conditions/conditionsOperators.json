{
  "label": "Condition Operators",
  "description": "* Second field (hidden initially) is dependent on First Field being greater than 10  \n\n * Fourth field (hidden initially) is dependent on Second Field being greater than 10 and less than or equal to 20",
  "id": "objectForm",
  "fields": [
    {
      "id": "firstField",
      "label": "First Field",
      "type": "number",
      "constraints": {
        "min": 0,
        "max": 100
      }
    },
    {
      "id": "secondField",
      "label": "Second Field",
      "type": "text",
      "placeholder": "Enter text here",
      "conditions":{
            "field": "firstField",
            "operator": "gt",
            "value": 10
          }
        },
        {
      "id": "thirdField",
      "label": "Third Field",
      "type": "number",
      "constraints": {
        "min": 0,
        "max": 100
      }
    },
    {
      "id": "Fourth Field",
      "label": "Fourth Field",
      "type": "text",
      "placeholder": "Enter text here",
      "conditionsSet":{
            "logic": "and",
            "conditions": [
                {
                    "field": "thirdField",
                    "operator": ">",
                    "value": 10
                },
                {
                    "field": "thirdField",
                    "operator": "<=",
                    "value": 20
                }
            ]
          }
    }
  ]
}