{
  "label": "Form with object",
  "id": "objectForm",
  "description": "Field 4 only shows up when when field1 is ***REMOVED***openUp***REMOVED*** OR field2 is ***REMOVED***open***REMOVED***, AND field3 is ***REMOVED***sesame***REMOVED***.",
  "fields": [
    {
      "id": "firstField",
      "label": "First Field",
      "type": "select",
      "options": [
        {
          "label": "Open up",
          "value": "openUp"
        },
        {
          "label": "Close down",
          "value": "closeDown"
        }
      ]
    },
    {
      "id": "secondField",
      "label": "Second Field",
      "type": "text",
      "placeholder": "Enter text here"
    },
    {
      "id": "thirdField",
      "label": "Third field",
      "type": "text"
    },
    {
      "id": "fourthField",
      "label": "Fourth field",
      "type": "text",
      "conditionsSet": {
        "logic": "or",
        "conditions": [
          {
            "dependsOn": "firstField",
            "operator": "=",
            "value": "openUp"
          },
          {
            "dependsOn": "secondField",
            "operator": "=",
            "value": "open"
          }
        ]
      },
      "conditions": {
        "dependsOn": "thirdField",
        "operator": "=",
        "value": "sesame"
      }
    }
  ]
}