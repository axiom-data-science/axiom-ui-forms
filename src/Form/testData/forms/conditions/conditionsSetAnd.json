{
  "label": "Condiions set example with AND logic",
  "id": "objectForm",
  "description": "Field 3 only shows up when when field1 is ***REMOVED***open***REMOVED*** AND field2 is ***REMOVED***sesame***REMOVED***.",
  "fields": [
    {
      "id": "firstField",
      "label": "First Field",
      "type": "select",
      "options": [
        {
          "label": "Open",
          "value": "open"
        },
        {
          "label": "Option 2",
          "value": "option2"
        }
      ]
    },
    {
      "id": "secondField",
      "label": "Second Field",
      "type": "text",
      "placeholder": "Enter text here"
    },
    {
      "id": "thirdField",
      "label": "Third field",
      "type": "text",
      "conditionsSet": {
        "logic": "and",
        "conditions": [
          {
            "dependsOn": "firstField",
            "operator": "=",
            "value": "open"
          },
          {
            "dependsOn": "secondField",
            "operator": "=",
            "value": "sesame"
          }
        ]
      }
    }
  ]
}