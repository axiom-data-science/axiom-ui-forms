[
    {
        "prop": "station_entry_method",
        "type": "select",
        "label": "Station Entry Method",
        "skip_path": true,
        "required": true,
        "options": [
            {"value": "new", "label": "Enter new station"},
            {"value": "search", "label": "Search for existing station"}
        ]
    },
    {
        "prop": "station_information.site_name",
        "required": true
    },
    {
        "prop": "station_information.geometry",
        "type": "geometry",
        "label" : "Approximate Position",
        "required": true,
        "description": "Select a point on the map or enter coordindates below",
        "settings": {
            "drawPointEnabled": true,
            "showCoordinateInput": true
        }
    },
     {
        "prop": "station_information.water_body_setting",
        "type": "select",
        "options": [
            {"value": "ocean", "label": "Ocean"},
            {"value": "estuary", "label": "Estuary"},
            {"value": "river", "label": "River"},
            {"value": "lake", "label": "Lake"},
            {"value": "other", "label": "Other"}
        ]
    },
    
    {
        "prop": "water_level_sensor_information.category",
        "type": "select",
        "required": true,
        "options": [
            {"value": "radar", "label": "Radar"},
            {"value": "acoustic", "label": "Acoustic"},
            {"value": "pressure", "label": "Pressure"},
            {"value": "other", "label": "Other"}
        ]
    },
