          "type": "object",
          "skip_path": true,
          "layout": "grid2",
          "fields": [
            {
              "id": "record-start-date",
              "label": "Record Start Date:",
              "required": false,
              "type": "date"
            },
            {
              "id": "record-end-date",
              "label": "Record End Date:",
              "required": false,
              "type": "date"
            }
          ]
        },
        {
          "id": "computational-tool",
          "label": "Computational Tool:",
          "required": false,
          "type": "select",
          "options": [
            {
              "value": "WALI",
              "label": "WALI"
            },
            {
              "value": "CO-OPS Tidal Datum Analysis Calculator",
              "label": "CO-OPS Tidal Datum Analysis Calculator"
            },
            {
              "value": "Tidelab",
              "label": "Tidelab"
            },
            {
              "value": "Manual",
              "label": "Manual"
            },
            {
              "value": "Other",
              "label": "Other"
            }
