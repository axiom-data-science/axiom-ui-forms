            {
              "id": "station-id-fields",
              "type": "object",
              "skip_path": true,
              "layout": "grid2",
              "fields": [
                {
                  "id": "wmo_platform_code",
                  "label": "CO-OPS ID",
                  "description": "Provided by CO-OPS. Only provide if known/established. Do not create. ",
                  "required": false,
                  "type": "text",
                  "settings": {
                    "descriptionPresentation": "tooltip"
                  },
                  "conditions": {
                    "field": "is-this-a-co-ops-station",
                    "value": false,
                    "result": "disable"
                  }
                },
                {
                  "id": "other-id",
                  "label": "Other ID",
