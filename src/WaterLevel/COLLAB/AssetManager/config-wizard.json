        {
          "id": "station-id-information",
          "skip_path": true,
          "type": "object",
          "label": "Station identification",
          "fields": [
            {
              "id": "is-this-a-co-ops-station",
              "label": "Is this a CO-OPS Station?",
              "type": "boolean",
              "description": "Filterable question to determine type of station being installed.",
              "required": false
