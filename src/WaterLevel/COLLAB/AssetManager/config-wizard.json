        {
          "id": "location",
          "label": "Location",
          "type": "object",
          "skip_path": true,

          "fields": [
            {
              "id": "use-map-location-entry",
              "label": "Select location on a map?",
              "type": "boolean",
              "description": "If no, will provide a text box for manual lat/lon entry. If yes, will provide map interface to select location and auto-populate lat/lon fields."
            },
            {
              "id": "manual-location-entry",
              "type": "object",
              "skip_path": "true",
              "layout": "grid3",
              "conditions": {
                "field": "use-map-location-entry",
                "value": false,
                "result": "include"
              },
              "fields": [
                {
                  "id": "latitude",
                  "label": "Latitude (DD, N is +)",
                  "required": false,
                  "type": "text"
                },
                {
                  "id": "longitude",
                  "label": "Longitude (DD, E is +)",
                  "required": false,
                  "type": "text"
                },
                {
                  "id": "horizontal-datum-projection-",
                  "label": "Horizontal datum projection ",
                  "description": "Horizontal datum for the lat/lon (eg: NAD83) / projection",
                  "required": false,
                  "type": "text",
                  "settings": {
                    "descriptionPresentation": "tooltip"
                  }
                }
              ]
            },
            {
              "id": "station-geometry",
              "label": "Click on map to select location",
              "type": "geometry",
              "conditions": {
                "field": "use-map-location-entry",
                "value": true,
                "result": "include"
              },
              "settings": {
                "drawPointEnabled": true,
                "drawEnabled": true
              }
            }
          ]
        }
