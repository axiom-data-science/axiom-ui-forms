        {
          "id": "computation-method",
          "label": "Computation method",
          "required": false,
          "type": "select",
          "options": [
            {
              "value": "TBYT",
              "label": "TBYT"
            },
            {
              "value": "MMSC",
              "label": "MMSC"
            },
            {
              "value": "FRED",
              "label": "FRED"
            }
          ]
        },
        {
          "id": "nwlon-control-station",
          "label": "NWLON Control Station:",
          "required": false,
          "type": "text"
        },
        {
          "id": "control-station-epoch",
          "label": "Control Station Epoch:",
          "required": false,
          "type": "select",
          "options": [
            {
              "value": "Present: 1983-2001",
              "label": "Present: 1983-2001"
            },
            {
              "value": "Superceded: 1960-1978",
              "label": "Superceded: 1960-1978"
            }
          ]
        },
        {
          "id": "datum-type",
          "label": "Datum Type:",
          "required": false,
          "type": "select",
          "options": [
            {
              "value": "Standard NTDE",
              "label": "Standard NTDE"
            },
            {
              "value": "Modified Procedure",
              "label": "Modified Procedure"
            },
            {
              "value": "Direct",
              "label": "Direct"
            }
          ]
        },
        {
          "id": "computation-date",
          "label": "Computation Date:",
          "required": false,
          "type": "date"
        },
        {
          "id": "computed-by",
          "label": "Computed by",
          "required": false,
          "type": "text"
        }
      ]
    },
    {
      "id": "tidal-datum-offsets-relative-to-station",
      "label": "Tidal Datums",
      "fields": [
        {
          "id": "tidal-datum-wrap",
          "type": "object",
          "skip_path": true,
          "layout": "grid3",
          "label": "Enter known tidal datum offsets relative to the station datum.",
          "fields": [
            {
              "id": "mhhw-m",
              "label": "MHHW (m):",
              "description": "Offset between station datum and MHHW in meters",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "mhw-m",
              "label": "MHW (m):",
              "description": "Offset between station datum and MHW in meters",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "dtl-m",
              "label": "DTL (m):",
              "description": "The arithmetic mean of mean higher high water and mean lower low water.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "mtl-m",
              "label": "MTL (m):",
              "description": "The arithmetic mean of mean high water and mean low water.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "msl-m",
              "label": "MSL (m):",
              "description": "The arithmetic mean of hourly heights observed over the National Tidal Datum Epoch. Shorter series are specified in the name; e.g. monthly mean sea level and yearly mean sea level.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "mlw-m",
              "label": "MLW (m):",
              "description": "Offset between station datum and MLW in meters.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "mllw-m",
              "label": "MLLW (m):",
              "description": "Offset between station datum and MLLW in meters",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "gt-m",
              "label": "GT (m)",
              "description": "The difference in height between mean higher high water and mean lower low water.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "mn-m",
              "label": "MN (m)",
              "description": "The difference in height between mean high water and mean low water.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "dhq-m",
              "label": "DHQ (m)",
              "description": "One-half the average difference between the two high waters of each tidal day observed over the National Tidal Datum Epoch. It is obtained by subtracting the mean of all the high waters from the mean of the higher high waters.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "dlq-m",
              "label": "DLQ (m)",
              "description": "One-half the average difference between the two low waters of each tidal day observed over the National Tidal Datum Epoch. It is obtained by subtracting the mean of the lower low waters from the mean of all the low waters.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "hwi-hr",
              "label": "HWI (hr)",
              "description": "The average interval (in hours) between the moon***REMOVED***s transit over the Greenwich meridian and the following high water at a location.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "lwi-hr",
              "label": "LWI (hr)",
              "description": "The average interval (in hours) between the moon***REMOVED***s transit over the Greenwich meridian and the following low water at a location.",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "igld",
              "label": "IGLD",
              "description": "International Great Lakes Datum",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            },
            {
              "id": "lwd",
              "label": "LWD",
              "description": "Low water datum",
              "required": false,
              "type": "number",
              "settings": {
                "descriptionPresentation": "tooltip"
              }
            }
          ]
        }
      ]
    },
