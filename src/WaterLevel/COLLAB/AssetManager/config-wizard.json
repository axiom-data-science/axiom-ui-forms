{
  "id": "collab-water level metadata",
  "label": "COLLAB Water Level Metadata",
  "wizard_steps": [
    {
      "id": "overview",
      "label": "Overview",
      "fields": [
        {
          "id": "overview-intro",
          "type": "object",
          "skip_path": true,
          "layout": "grid2",
          "fields": [
            {
              "id": "prepared-by",
              "label": "Prepared by",
              "description": "Person completing form",
              "required": false,
              "type": "text"
            },
            {
              "id": "date-prepared",
              "label": "Date prepared",
              "description": "Date of form completion",
              "required": false,
              "type": "date"
            }
          ]
        },
        {
          "id": "update-or-new-station",
          "label": "Update or new station? ",
          "description": "Is this an update to an existing station or an entirely new station? ",
          "required": false,
          "type": "select",
          "defaultValue": "New",
          "options": [
            {
              "value": "Update",
              "label": "Update"
            },
            {
              "value": "New",
              "label": "New"
            }
          ]
        },
        {
          "id": "modified-station-information",
          "label": "Describe station modifications",
          "type": "object",
          "skip_path": true,
          "conditions": {
            "field": "update-or-new-station",
            "value": "Update",
            "result": "include"
          },
          "fields": [
            {
              "id": "previous-site-log",
              "label": "Previous site log",
              "description": "If this is an update to an existing station, please attach the previous site log if you have access",
              "settings": {
                "descriptionPresentation": "tooltip"
              },
              "required": false,
              "type": "text"
            },
            {
              "id": "modified-added-section",
              "label": "Modified/added section",
              "required": false,
              "type": "text"
            },
            {
              "id": "reason-for-update",
              "label": "Reason for update",
              "description": "If this is an update to an existing station, please provide a brief (1-3 sentences) explaining why this update occurred. ",
              "settings": {
                "descriptionPresentation": "tooltip"
              },
              "required": false,
              "type": "long_text"
            }
          ]
        },
        {
          "id": "funding",
          "label": "Funding",
          "type": "object",
          "skip_path": true,
          "fields": [
            {
              "id": "funding-source",
              "label": "Funding source",
              "description": "If known, please provide the funding source",
              "required": false,
              "type": "text"
            },
            {
              "id": "funding-grant",
              "label": "Funding grant",
              "description": "If known, please provide the grant",
              "required": false,
              "type": "text"
            }
          ]
        },
        {
          "id": "deployment-year-of-proposal",
          "label": "Deployment year of proposal",
          "required": false,
          "type": "number"
        }
      ]
    },
