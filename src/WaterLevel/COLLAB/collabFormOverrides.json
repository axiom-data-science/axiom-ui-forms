    {
      "id": "contributors-list",
      "label": "Contributors List",
      "description": "- **Custodian:** Party that accepts accountability and responsibility for the data, and ensures appropriate care and maintenance of the resource\n- **Community Point of Contact:** Name of community contact, if applicable. This information is not reported to ERDDAP. It is only recorded for RA project tracking purposes. \n- **Owner:** Party that owns the resource\n- **Data Publisher:** Party who published the resource\n- **Data Processor:** Party that has processed the data in a manner such that the resource has been modified\n- **Funder:** Party providing monetary support for the resource\n- **Distributor:** Party who distributes the resource. Example, Hohonu, Divirod, etc. These distributors provide a packaged instrument, not a single sensor.\n\nYou may enter the same information for multiple roles. Use the ***REMOVED***Duplicate***REMOVED*** button to copy information from a role and create a new one. Each role can only be entered once",
      "fields": [
        {
          "prop": "contributor",
          "type": "objectList",
          "label": "",
          "settings": {
            "keyField": "role",
            "showInitialObject": true,
            "excludeKeyFieldFromValue": true,
            "boldLabel": true
          },
          "fields": [
            {
              "prop": "role",
              "type": "select"
            },
            {
              "id": "contributor-fields",
              "label": "",
              "type": "objectWrapper",
              "layout": "grid3",
              "fields": [
                {
                  "prop": "name"
                },
                {
                  "prop": "phone"
                },
                {
                  "prop": "email"
                },
                {
                  "prop": "url"
                },
                {
                  "prop": "affiliation"
                }
              ]
            }
          ]
        }
      ]
    },
