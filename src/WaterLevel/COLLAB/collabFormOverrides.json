    {
      "id": "sensor-information",
      "label": "Sensor Information",
      "description": "Enter one or more sensors. Definitions:  - Platform is the type of asset, and this term is defined with options by ERDDAP. For WL, it is considered a ***REMOVED***station***REMOVED*** platform.   - Station is the physical location of a deployment. For example, West Dock Station.  - Instrument is the large physical instrument that may house individual or smaller components, aka sensors.   - Components are the individual sensors within an instrument. There may be multiple components within a single instrument.  Example two radar gauges within one instrument.  - Discriminant is the serial number of the individual component(s), if applicable, or the instrument itself.",
      "fields": [
        {
          "prop": "sensors",
          "type": "object",
          "multiple": true,
          "tabs": [
            {
              "id": "overview",
              "label": "Overview",
              "fields": [
                {
                  "id": "time-coverage-wrapper",
                  "label": "Time coverage",
                  "type": "objectWrapper",
                  "fields": [
                    {
                      "prop": "sensors[].is-real-time",
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "id": "start-end-wrapper",
                  "label": "",
                  "type": "objectWrapper",
                  "layout": "grid2",
                  "fields": [
                    {
                      "prop": "sensors[].time_coverage_start",
                      "type": "date",
                      "settings": {
                        "descriptionPresentation": "tooltip",
                        "smallLabel": true
                      }
                    },
                    {
                      "prop": "sensors[].time_coverage_end",
                      "description": "Only if not real-time. If real-time, leave blank.",
                      "type": "date",
                      "settings": {
                        "descriptionPresentation": "tooltip",
                        "smallLabel": true
                      }
                    }
                  ]
                },
                {
                  "id": "sample-wrapper",
                  "label": "Sampling",
                  "type": "objectWrapper",
                  "layout": "grid2",
                  "fields": [
                    {
                      "prop": "sensors[].sample-interval-min",
                      "type": "selectOrText",
                      "settings": {
                        "descriptionPresentation": "tooltip",
                        "smallLabel": true
                      }
                    },
                    {
                      "prop": "sensors[].sample-average-window-sec",
                      "type": "selectOrText",
                      "settings": {
                        "descriptionPresentation": "tooltip",
                        "smallLabel": true
                      }
                    }
                  ]
                },
                {
                  "prop": "sensors[].mounting-structure"
                },
                {
                  "prop": "sensors[].geophysical_variable:accuracy"
                },
                {
                  "prop": "sensors[].telemetry-method"
                },
                {
                  "prop": "sensors[].date-removed"
                },
                {
                  "prop": "sensors[].is-station-surveyed"
                }
              ]
            },
            {
              "id": "sensor-information",
              "label": "Instrument and installation",
              "fields": [
                {
                  "id": "instrument-wrapper",
                  "label": "Instrument",
                  "type": "objectWrapper",
                  "layout": "grid2",
                  "fields": [
                    {
                      "prop": "sensors[].instrument",
                      "label": "Instrument",
                      "settings": {
                        "descriptionPresentation": "tooltip",
                        "smallLabel": true
                      }
                    },
                    {
                      "prop": "sensors[].instrument_variable:component",
                      "label": "Component",
                      "settings": {
                        "descriptionPresentation": "tooltip",
                        "smallLabel": true
                      }
                    }
                  ]
                },
                {
                  "prop": "sensors[].instrument_variable:make_model",
                  "label": "Make/Model",
                  "settings": {
                    "descriptionPresentation": "tooltip",
                    "smallLabel": true
                  }
                },
                {
                  "prop": "sensors[].sensor-serial-number"
                },
                {
                  "id": "prior-wrapper",
