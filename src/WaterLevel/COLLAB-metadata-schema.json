{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "COLLAB Water Level Metadata",
  "type": "object",
  "properties": {
    "preparedBy": {
      "type": "string",
      "title": "Prepared by",
      "description": "Person completing form"
    },
    "datePrepared": {
      "type": "string",
      "title": "Date prepared",
      "format": "date"
    },
    "updateOrNewStation": {
      "type": "string",
