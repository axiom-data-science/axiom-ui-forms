      "enum": ["Hohonu", "Greenstream", "Hobo", "Divirod", "Community Sensor", "Other"]
    },
    "sensorType": {
      "type": "string",
      "title": "Sensor - type",
      "description": "Sensor is defined as the specific component. In this instance, this is the Water Level Sensor",
        "enum": ["Radar", "Pressure (vented or non-vented)", "Acoustic", "GNSS-R", "GNSS Buoy", "Ultrasonic"]
    },
