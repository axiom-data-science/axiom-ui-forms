      "description": "Link to RA-specific station",
      "format": "uri"
    },
    "dataProvider": {
      "type": "string",
      "title": "Data provider",
      "description": "Name of data provider, such as ***REMOVED***Hohonu***REMOVED*** or other company. Not a link"
