    },
    "fundingGrant": {
      "type": "string",
      "title": "Funding grant"
    },
    "deploymentYearOfProposal": {
      "type": "string",
      "title": "Deployment year of proposal"
    },
    "operatorPOC": {
      "type": "string",
      "title": "Operator POC"
    },
    "telephonePrimary": {
      "type": "string",
      "title": "Telephone (primary)",
      "format": "phone"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "affiliation": {
      "type": "string",
      "title": "Affiliation"
    },
    "communityPOCName": {
      "type": "string",
      "title": "Community POC name"
    },
    "communityPOCTelephone": {
      "type": "string",
      "title": "Community POC telephone",
      "format": "phone"
    },
    "communityPOCEmail": {
      "type": "string",
      "title": "Community POC email",
      "format": "email"
    },
    "communityPOCAffiliation": {
      "type": "string",
      "title": "Community POC Affiliation"
    },
    "dataManagementEntity": {
      "type": "string",
      "title": "Data Management - Entity"
    },
    "dataManagementPOC": {
      "type": "string",
      "title": "Data Management - POC"
    },
    "dataManagementAffiliation": {
      "type": "string",
      "title": "Data Management - Affiliation"
    },
    "dataManagementTelephone": {
