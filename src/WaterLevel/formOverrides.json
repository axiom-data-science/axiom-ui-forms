{
    "label": "Water Level Station Definition",
    "id": "water_level_station_definition",
    "wizard_steps": [
        {
            "id": "station_information",
            "label": "Station Information",
            "fields": [
                {
                    "prop": "station_entry_method"
                },
                {
                    "prop": "station_search",
                    "type": "custom:station_search",
                    "placeholder": "Search for existing station",
                    "conditions": {
                        "dependsOn": "station_entry_method",
                        "value": "search"
                    }
                },
                {
                    "prop" : "station_information_wrap",
                    "type": "object",
                    "skip_path": true,
                    "label": "",
                    "conditions": {
                        "dependsOn": "station_entry_method",
                        "value": "new"
                    },
                    "fields": [
                        {
                            "prop": "station_information.site_name"
                        },
                        {
                            "prop": "station_identifiers",
                            "label": "Identifiers",
                            "skip_path": true,
                            "type": "object",
                            "layout": "horizontal",
                            "fields": [
                                {"prop": "station_information.identifiers.co_ops_id"},
                                {"prop": "station_information.identifiers.other_id"}
                            ]

                        },
                        {
                            "prop": "station_information.water_body_setting"
                        },
                        {
                            "prop": "station_information.state"
                        },
                        {
                            "prop": "station_information.geometry"
                        }

                    ]
                }
            ]
        },
        {
            "label" : "Sensor information",
            "id" : "water_level_sensor_information",
            "pages": [
                
                {
                    "id": "general_information",
                    "label": "General Information",
                    "fields": [
                        {"prop" :"water_level_sensor_information.category", "defaultValue": "radar"},
                        {"prop" :"water_level_sensor_information.manufacturer_model"},
                        {"prop" :"water_level_sensor_information.serial_number"}
                    ]
                },
                {
                    "id": "sampling_information",
                    "label": "Sampling Information",
                    "fields": [
                        {"prop" :"water_level_sensor_information.sample_interval_min"},
                        {"prop" :"water_level_sensor_information.sample_avg_window_sec"}
                    ]
                },
                {
                    "id": "installation",
                    "label": "Installation",
                    "fields": [
                        {"prop" :"water_level_sensor_information.mounting_structure"},
                        {"prop" :"water_level_sensor_information.date_installed"},
                        {"prop" :"water_level_sensor_information.date_removed"}
                    ]
                },
                {
                    "id" : "zero_elevation_on_station_datum",
                    "label": "Zero Elevation on Station Datum",
                    "fields": [
                        {
                            "prop" : "zero_elev_wrap",
                            "label": "Zero Elevation on Station Datum",
                            "description": "Add one or more",
                            "skip_path": true,
                            "type": "object",
                            "fields": [
                                {
                                    "prop" :"water_level_sensor_information.zero_elevation_on_station_datum", 
                                    "layout": "horizontal",
                                    "label": ""
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "additional_information",
                    "label": "Notes",
                    "fields": [
                        {"prop" :"water_level_sensor_information.additional_information"}
                    ]
                }

            ]
        },
        {
            "id": "vertical_control_information",
            "label": "Vertical Control",
            "pages": [
                {
                    "id": "station_datum",
                    "label": "Station Datum",
                    "fields": [
                        {"prop" :"sensor_vertical_control.station_datum"}
                    ]   
                },
                {
                    "id": "markers",
                    "label": "Markers",
                    "description": "Add one or more vertical control markers.",
                    "fields": [
                        {
                            "prop" :"sensor_vertical_control.markers_wrap"
                        }
                    ]
                }

            ]
        },
        {
            "id": "local_tidal_datum_establishment_page",
            "label": "Local Tidal Datum Establishment",
            "pages": [
                {
                    "id": "local_tidal_datum_establishment",
                    "label": "Local Tidal Datum Establishment",
                    "fields": [
                        {
                            "prop": "local_tidal_datum_establishment_wrap",
                            "type": "object",
                            "skip_path": true,
                            "label": "Tester",
                            "conditions": {
                                "dependsOn": "water_level_sensor_information.category",
                                "value": "radar",
                                "result": "disable"
                            },
                            "fields": [
                                {
                                    "prop": "local_tidal_datum_establishment.dates",
                                    "label": "",
                                    "skip_path": true,
                                    "type": "object",
                                    "layout": "horizontal",
                                    "fields": [
                                        {"prop": "local_tidal_datum_establishment.record_start_date"},
                                        {"prop": "local_tidal_datum_establishment.record_end_date"}
                                    ]
                                },
                                {
                                    "prop": "local_tidal_datum_establishment.computation",
                                    "label": "",
                                    "skip_path": true,
                                    "type": "object",
                                    "layout": "horizontal",
                                    "fields": [
                                        {"prop": "local_tidal_datum_establishment.computation_tool"},
                                        {"prop": "local_tidal_datum_establishment.computation_method"},
                                        {"prop": "local_tidal_datum_establishment.computed_by"}
                                    ]
                                },
                                {
                                    "prop": "local_tidal_datum_establishment.control_station",
                                    "label": "",
                                    "skip_path": true,
                                    "type": "object",
                                    "layout": "horizontal",
                                    "conditions": {
                                        "dependsOn": "water_level_sensor_information.category",
                                        "value": "radar",
                                        "result": "enable"
                                    },
                                    "fields": [
                                        {"prop": "local_tidal_datum_establishment.control_station_stamping"},
                                        {"prop": "local_tidal_datum_establishment.control_station_ngs_pid"},
                                        {"prop": "local_tidal_datum_establishment.control_station_epoch"}
                                    ]
                                },
                                {
                                    "prop": "local_tidal_datum_establishment.datum_computation",
                                    "label": "",
                                    "skip_path": true,
                                    "type": "object",
                                    "layout": "horizontal",
                                    "fields": [
                                        {"prop": "local_tidal_datum_establishment.datum_type"},
                                        {"prop": "local_tidal_datum_establishment.computation_date"}
                                    ]
                                }

                            ]
                        }

                    ]
                },
                {
                    "id": "datums",
                    "label": "Datums",
                    "fields": [
                        {
                            "prop": "local_tidal_datum_establishment.tidal_datums_relative_to_station_datum",
                            "label": "Tidal datum offsets relative to station datum",
                            "description": "More information on datums is available on the **[COOPS website](https://tidesandcurrents.noaa.gov/datum_options.html)**.",
                            "layout": "grid3"
                        }
                    ]
                }
            ]
        }
    ]
}